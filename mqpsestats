p = devModPath(pypath = '/home/pi/Projects/sestats/pathlist.txt')

import argparse
from __init__ import VERSION

USAGE = \
"""
mqpsestats --inputpath <path to logfile> --fullreport
"""

DESCRIPTION = \
"""
Show statistic for the Special Event 1x1 stations in the Missouri QSO
Party. 
"""

EPILOG = \
"""
Running with no parameters will launch the GUI.
"""

def parseMyArgs():
    parser = argparse.ArgumentParser(\
                    description = DESCRIPTION, usage = USAGE)
    parser.add_argument('-v', '--version', 
                        action='version', 
                        version = VERSION)
    
    parser.add_argument('-i', '--inputpath', default=None,
        help="""Load details for 1x1 operators/stations from the .csv
             file generated by the status1x1 web scraper. By default 
             this would be operators.csv. If the filename is INIT, an 
             empty table will be created. Note that
             this option deletes and replaces what is currently in the
             database, so back it up using phpMyAdmin or mysqldump 
             before running.""")
        
    parser.add_argument('-c', '--callsign', default=None,
        help="""Fetch details for CALLSIGN from MOQP database. 
             Entering 'allcalls' will run the report on all the 1x1 
             calls in the database.""")
 

    parser.add_argument('-t', '--reportType',
                                   choices = ['csv','html'],
                                   default = 'csv',
            help="""Set report type for output. Only valid if more than
                    one report output type is avaible. Options are: 
                    csv (Comma Separated Variables) for printing or
                    for import to a spreadsheet, or 
                    html for web page use.
                    default value is csv""")
    args = parser.parse_args()
    return args
    
if __name__ == '__main__':
    args = parseMyArgs()
    #print(args)
    #print(sys.path)
    if (args.inputpath):
        from sestats import seStats
        app = seStats(args)
        
        for key in app.sesDict.keys():
            app.sesDict[key].show_params()
            print(f'{app.sesDict[key].id}\n{app.sesDict[key].logid}')
        
    elif (args.callsign):
        from sestats import seStats
        app = seStats(args)
        app.sesReport(args)
        
